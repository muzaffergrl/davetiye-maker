{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "davetiye-maker/content-record",
  "title": "Event content record (single source of truth per event/demo)",
  "description": "Video, website, misafir PDF'i ve START HERE dosyasındaki tüm kişisel bilgiler bu kayıttan gelir. Formatlar kendiliğinden senkronize değildir; tools/validate_content.py ve icerik-tutarlilik skill'i ile denetlenir.",
  "type": "object",
  "required": ["record_kind", "event_type", "locale", "partners", "initials", "date", "timezone", "venue", "schedule", "rsvp", "urls", "media", "optional_blocks"],
  "additionalProperties": false,
  "properties": {
    "record_kind": { "enum": ["demo", "customer"], "description": "demo = kurgu içerik; customer = gerçek alıcı verisi (repoya konmaz)" },
    "event_type": { "enum": ["wedding", "engagement", "save_the_date", "bridal_shower", "other"] },
    "locale": { "enum": ["en-US", "en-GB", "en-CA", "en-AU"] },
    "partners": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "required": ["display_name"], "additionalProperties": false,
        "properties": {
          "display_name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "full_name": { "type": ["string", "null"], "maxLength": 40 }
        }
      }
    },
    "name_display": { "type": "string", "maxLength": 85, "description": "Ör. 'Avery & Jordan'. En çok 85 = iki isim (≤ 40) + ayraç (' & ', ' and ') (G055)" },
    "initials": { "type": "string", "maxLength": 9, "description": "Monogram, ör. 'A & J'" },
    "host_line": { "type": ["string", "null"], "description": "Ör. 'Together with our families' — opsiyonel, varsayılmaz" },
    "date": { "type": "string", "format": "date", "description": "ISO YYYY-MM-DD; gösterim locale'e göre üretilir" },
    "ceremony_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "timezone": { "type": "string", "description": "IANA, ör. America/Los_Angeles" },
    "venue": {
      "type": "object", "required": ["name", "city"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "city": { "type": "string" },
        "region": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] }
      }
    },
    "schedule": {
      "type": "array", "maxItems": 10,
      "description": "Program satırları; en çok 10 (G055 — temalar 10 satırı taşır, docs/11 §12).",
      "items": {
        "type": "object", "required": ["label", "time"], "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "location": { "type": ["string", "null"] }
        }
      }
    },
    "dress_code": { "type": ["string", "null"] },
    "rsvp": {
      "type": "object", "required": ["deadline"], "additionalProperties": false,
      "properties": {
        "deadline": { "type": "string", "format": "date" },
        "method": { "enum": ["canva_form", "external_form", "email", "none", null] },
        "required": {
          "type": "object", "additionalProperties": false,
          "description": "İsteğe bağlı (G128): formun hazır alanlarından zorunlu olanlar. Ad ve katılım her zaman zorunludur; e-posta ve çifte not varsayılan olarak isteğe bağlıdır.",
          "properties": { "email": { "type": "boolean" }, "message": { "type": "boolean" } }
        },
        "questions": {
          "type": "array", "maxItems": 10,
          "description": "İsteğe bağlı (G051, G128): misafir yanıt formundaki özel sorular (ör. menü seçimi). id kalıcıdır (yanıtlar id ile saklanır); choice = seçenekli (en az 2 seçenek), text = kısa yanıt, long = uzun yanıt, yesno = evet/hayır, number = tam sayı (0–9999); choice dışındakiler seçeneksiz. required: true = katılan misafir yanıtlamadan gönderemez. İş kuralları validate_content.py'de.",
          "items": {
            "type": "object", "required": ["id", "label", "type"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 24 },
              "label": { "type": "string", "maxLength": 120 },
              "type": { "enum": ["choice", "text", "long", "yesno", "number"] },
              "required": { "type": "boolean" },
              "options": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 60 } }
            }
          }
        }
      }
    },
    "urls": {
      "type": "object", "additionalProperties": false,
      "description": "Gerçek ve doğrulanmış değilse null. Demo kayıtta hepsi null kalmalı.",
      "properties": {
        "website": { "type": ["string", "null"], "format": "uri" },
        "rsvp_form": { "type": ["string", "null"], "format": "uri" },
        "map": { "type": ["string", "null"], "format": "uri" },
        "registry": { "type": ["string", "null"], "format": "uri" },
        "accommodation": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "hero_portrait": { "type": ["string", "null"] },
        "memory_photos": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
        "couple_clip": { "type": ["string", "null"] },
        "venue_image": { "type": ["string", "null"] }
      }
    },
    "optional_blocks": {
      "type": "object", "additionalProperties": false,
      "description": "true = gösterilir. Hiçbiri kültürel zorunluluk değildir.",
      "properties": {
        "our_story": { "type": "boolean" },
        "countdown": { "type": "boolean" },
        "dress_code": { "type": "boolean" },
        "registry": { "type": "boolean" },
        "travel_stay": { "type": "boolean" },
        "faq": { "type": "boolean" },
        "guest_policy": { "type": "boolean" }
      }
    },
    "story": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (K24 website): Our Story giriş cümlesi ve fotoğraf başlıkları. Fotoğraflar tema foto alanlarından gelir.",
      "properties": {
        "intro": { "type": "string", "maxLength": 200 },
        "items": {
          "type": "array", "maxItems": 12,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["caption"],
            "properties": {
              "caption": { "type": "string", "maxLength": 60 },
              "text": { "type": "string", "maxLength": 400 }
            }
          }
        }
      }
    },
    "thank_you": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (G075, K28): düğün sonrası teşekkür modu. mode: auto = düğün günü bitince (site saat diliminde ertesi gün 00:00) kendiliğinden, on = hemen, off = hiç (yoksa auto). title boşsa 'Thank you for celebrating with us'; message ≤ 400; photo yoksa temanın süsü (yer tutucu değil); details: keep = Details sayfası 'The Day' olarak kalır, hide = gizlenir. Teşekkür modunda RSVP kapalıdır.",
      "properties": {
        "mode": { "enum": ["auto", "on", "off"] },
        "title": { "type": ["string", "null"], "maxLength": 60 },
        "message": { "type": ["string", "null"], "maxLength": 400 },
        "photo": { "type": ["string", "null"] },
        "details": { "enum": ["keep", "hide"] }
      }
    },
    "maps": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (G127): Details sayfasında mekân haritası ve yol tarifi. venue = ana mekânın (venue.* + urls.map linki) ayarları; reception = ayrı bir resepsiyon mekânı (yoksa null). show_map / show_directions yoksa: adres, koordinat ya da çözülebilen harita linki varsa açık. lat/lng: harita linkinden çözülen konum (yoksa adres metniyle aranır). label: iki mekân varken başlık (boşsa 'Ceremony' / 'Reception'). Harita misafir 'Show map'e dokununca yüklenir (Google Maps embed, API anahtarı yok); teşekkür modunda gösterilmez.",
      "properties": {
        "venue": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "label": { "type": ["string", "null"], "maxLength": 40 },
            "show_map": { "type": "boolean" },
            "show_directions": { "type": "boolean" },
            "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
          }
        },
        "reception": {
          "type": ["object", "null"], "required": ["name"], "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 80 },
            "address": { "type": ["string", "null"], "maxLength": 200 },
            "city": { "type": ["string", "null"], "maxLength": 80 },
            "link": { "type": ["string", "null"], "format": "uri" },
            "label": { "type": ["string", "null"], "maxLength": 40 },
            "show_map": { "type": "boolean" },
            "show_directions": { "type": "boolean" },
            "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "copy": {
      "type": "object", "maxProperties": 200,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,47}$" },
      "additionalProperties": { "type": ["string", "null"], "maxLength": 300 },
      "description": "İsteğe bağlı (G068, K28): temanın düzenlenebilir sabit metinleri — başlıklar, etiketler, düğmeler, gezinme (ör. envelope_kicker = 'You are invited', rsvp_title = 'Will You Join Us?'). Anahtar → çiftin metni; boş/null = tasarımın metni. Anahtar listesi, varsayılan ve tasarımın taşıdığı en uzun metin (max) temanın theme.json 'copy' manifestindedir; bilinmeyen anahtar ve max aşımı platformda (lib/theme/copy.ts) denetlenir. Kimlik alanı değildir: değiştirmek isim/tarih hakkı harcamaz."
    },
    "languages": {
      "type": "object", "required": ["primary"], "additionalProperties": false,
      "properties": {
        "primary": { "enum": ["en", "tr", "es", "de", "fr"] },
        "extra": { "type": "array", "maxItems": 4, "items": { "enum": ["en", "tr", "es", "de", "fr"] } }
      },
      "description": "İsteğe bağlı (G144, K45 madde 3): sitenin dilleri — ana dil (çiftin kendi metni bu dilde; yoksa en) ve ek diller. Misafir sitesi /<slug>?lang=<dil> ile açılır, dil seçici yalnız ek dil varken görünür. Temanın sabit metinleri ve platform arayüzü bizim önceden yazdığımız sözlüklerden gelir."
    },
    "translations": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "en": { "type": "object", "maxProperties": 400, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" }, "additionalProperties": { "type": "object", "required": ["text", "src"], "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 4000 }, "src": { "type": "string", "pattern": "^[0-9a-f]{8}$" }, "ok": { "type": "boolean" }, "auto": { "type": "string", "enum": ["browser", "service"] } } } },
        "tr": { "type": "object", "maxProperties": 400, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" }, "additionalProperties": { "type": "object", "required": ["text", "src"], "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 4000 }, "src": { "type": "string", "pattern": "^[0-9a-f]{8}$" }, "ok": { "type": "boolean" }, "auto": { "type": "string", "enum": ["browser", "service"] } } } },
        "es": { "type": "object", "maxProperties": 400, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" }, "additionalProperties": { "type": "object", "required": ["text", "src"], "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 4000 }, "src": { "type": "string", "pattern": "^[0-9a-f]{8}$" }, "ok": { "type": "boolean" }, "auto": { "type": "string", "enum": ["browser", "service"] } } } },
        "de": { "type": "object", "maxProperties": 400, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" }, "additionalProperties": { "type": "object", "required": ["text", "src"], "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 4000 }, "src": { "type": "string", "pattern": "^[0-9a-f]{8}$" }, "ok": { "type": "boolean" }, "auto": { "type": "string", "enum": ["browser", "service"] } } } },
        "fr": { "type": "object", "maxProperties": 400, "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){0,4}$" }, "additionalProperties": { "type": "object", "required": ["text", "src"], "additionalProperties": false, "properties": { "text": { "type": "string", "maxLength": 4000 }, "src": { "type": "string", "pattern": "^[0-9a-f]{8}$" }, "ok": { "type": "boolean" }, "auto": { "type": "string", "enum": ["browser", "service"] } } } }
      },
      "description": "İsteğe bağlı (G144): çiftin kendi metinlerinin ek dillere çevirisi — dil → içerik yolu (ör. story.intro, faq.0.a, copy.rsvp_title) → {text, src: kaynak metnin 8 haneli özeti, ok: çift onayladı mı, auto: browser|service}. Misafir yalnız onaylı (ok) ve kaynağı değişmemiş (src tutan) çeviriyi görür; aksi halde ana dildeki metin gösterilir (lib/i18n/content.ts)."
    },
    "faq": {
      "type": "array", "maxItems": 12,
      "description": "İsteğe bağlı (G051): Sık sorulan sorular — soru (q) ve yanıt (a). optional_blocks.faq açıkken gösterilir. Boş soru/yanıt iş kuralıyla reddedilir.",
      "items": {
        "type": "object", "required": ["q", "a"], "additionalProperties": false,
        "properties": {
          "q": { "type": "string", "maxLength": 120 },
          "a": { "type": "string", "maxLength": 600 }
        }
      }
    },
    "travel": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (G138): Ulaşım & Konaklama — Details sayfasındaki Travel & Stay bölümünün içeriği (bölüm optional_blocks.travel_stay ile açılır/kapanır). airport / parking / shuttle / taxi: kısa metin + isteğe bağlı link (ikisi de boşsa gösterilmez). stays: 0–6 otel/konaklama kartı (name zorunlu; address, link, code = indirim kodu ya da oda bloğu adı, note, distance = ör. '10 min drive'). Boşsa sitede iz yok; teşekkür modunda gösterilmez. Eski urls.accommodation linki aynı bölümün düğmesi olarak kalır.",
      "properties": {
        "airport": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "text": { "type": ["string", "null"], "maxLength": 300 },
            "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 }
          }
        },
        "parking": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "text": { "type": ["string", "null"], "maxLength": 300 },
            "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 }
          }
        },
        "shuttle": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "text": { "type": ["string", "null"], "maxLength": 300 },
            "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 }
          }
        },
        "taxi": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "text": { "type": ["string", "null"], "maxLength": 300 },
            "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 }
          }
        },
        "stays": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "required": ["name"], "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 80 },
              "address": { "type": ["string", "null"], "maxLength": 160 },
              "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 },
              "code": { "type": ["string", "null"], "maxLength": 60 },
              "note": { "type": ["string", "null"], "maxLength": 300 },
              "distance": { "type": ["string", "null"], "maxLength": 40 }
            }
          }
        }
      }
    },
    "meal": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (G138): yemek. served: true = yemek var (Details'te menü kartı ya da menü yoksa tek satır), false = yok, null/yok = gizli (sitede iz yok). courses: menü başlıkları (ör. Starter / Main / Dessert, en çok 6) ve altında kalemler (en çok 10). note: diyet notu (ör. 'Vegetarian and gluten-free options on request'). Teşekkür modunda gösterilmez.",
      "properties": {
        "served": { "type": ["boolean", "null"] },
        "courses": {
          "type": "array", "maxItems": 6,
          "items": {
            "type": "object", "required": ["title", "items"], "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "maxLength": 40 },
              "items": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 120 } }
            }
          }
        },
        "note": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "details_blocks": {
      "type": "array", "maxItems": 10,
      "description": "İsteğe bağlı (G138): The Day / Details sayfasında 0–10 serbest içerik bloğu (ör. dress code, çocuk politikası, hediye, park, hava durumu). title zorunlu; text, link (+ link_label, boşsa 'Learn more') ve icon isteğe bağlı. Boş liste = sitede iz yok; teşekkür modunda gösterilmez.",
      "items": {
        "type": "object", "required": ["title"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 60 },
          "text": { "type": ["string", "null"], "maxLength": 600 },
          "link": { "type": ["string", "null"], "format": "uri", "maxLength": 500 },
          "link_label": { "type": ["string", "null"], "maxLength": 30 },
          "icon": { "type": ["string", "null"], "enum": [null, "info", "dress", "kids", "gift", "car", "weather", "camera", "music", "glass", "heart"] }
        }
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "description": "İsteğe bağlı (G126): ses. music: varsayılan parça kimliği (platform/lib/audio/catalog.ts MUSIC_TRACKS), 'custom' = çiftin yüklediği music_file, 'off' = müzik yok; yoksa tasarımın varsayılan parçası. Müzik yalnız Our Story sayfasında çalar. music_name = yüklenen dosyanın adı (panelde gösterilir). effects: zarf açılışı, sayfa geçişi, RSVP gönderimi ses efektleri (yoksa açık).",
      "properties": {
        "music": { "type": "string", "pattern": "^(off|custom|[a-z0-9-]{1,40})$" },
        "music_file": { "type": ["string", "null"], "maxLength": 500 },
        "music_name": { "type": ["string", "null"], "maxLength": 120 },
        "effects": { "type": "boolean" }
      }
    }
  }
}
