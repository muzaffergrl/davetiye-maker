{
  "name": "davetiye-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/theme-assets.cjs --clean",
    "dev": "next dev",
    "prebuild": "node scripts/theme-assets.cjs",
    "build": "next build",
    "postbuild": "node scripts/trace-check.cjs && node scripts/js-budget.cjs",
    "prestart": "node scripts/theme-assets.cjs",
    "start": "next start",
    "test": "node --test --test-reporter=spec \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.ts",
    "screenshot": "node scripts/screenshot.cjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "141.0.0",
    "@vercel/blob": "2.8.0",
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "exceljs": "4.4.0",
    "imapflow": "2.1.2",
    "lucide-react": "1.46.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "hoodiecrow-imap": "3.3.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "5.4.296",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
